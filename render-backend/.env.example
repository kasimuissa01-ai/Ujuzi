# Ujuzi Scraper & AI Service - Render Environment Variable Template
# Copy these keys into your Render Web Service dashboard

# Port - Render will assign this automatically, but you can set 3000 locally
PORT=3000

# Apify scraper token (required for active, fresh Fiverr & Upwork job extraction)
# Find this in your Apify Console under Settings > Integrations > API Token
APIFY_TOKEN=

# Gemini API Key (required for dynamic AI backup jobs and freelance proposal creation)
# Find this in your Google AI Studio under Get API Key
GEMINI_API_KEY=

# Groq API Key (required if you use Groq as a backup chatbot)
# Find this in your Groq Console under API Keys
GROQ_API_KEY=

# OneSignal Credentials (required if sending pushes and broadcasting cron jobs)
# App ID - publicly accessible on OneSignal Dashboard
ONESIGNAL_APP_ID=1780c6e8-a0f3-4cc8-a5e1-a328a231a995
# REST API Key - keeps cron-job broadcasts secure! Under Settings > Keys & IDs on OneSignal Console
ONESIGNAL_REST_API_KEY=

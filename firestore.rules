rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Validation functions
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidUserProgress(data) {
      return data.keys().hasAll(['userId', 'completedLessons', 'streakDates', 'updatedAt']) &&
             data.userId is string &&
             data.userId == request.auth.uid &&
             data.completedLessons is list &&
             data.completedLessons.size() <= 1000 &&
             data.streakDates is list &&
             data.streakDates.size() <= 1000;
    }

    match /user_progress/{userId} {
      // Users can only read their own progress
      allow read: if isSignedIn() && isOwner(userId);
      
      // Allow creation if the data matches the schema
      allow create: if isSignedIn() && 
                    isOwner(userId) && 
                    isValidUserProgress(incoming()) &&
                    incoming().updatedAt == request.time;
                    
      // Allow update if the data matches schema and fields are correctly updated
      allow update: if isSignedIn() && 
                    isOwner(userId) && 
                    isValidUserProgress(incoming()) &&
                    incoming().updatedAt == request.time &&
                    incoming().userId == existing().userId; // Immutable
    }
  }
}
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Validation functions
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function isOwner(userId) { 
      return request.auth != null && request.auth.uid == userId; 
    }

    // User Progress rules: Only the owner of the progress can read/write their own progress
    match /user_progress/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Notifications rules: Only user can view and manage their in-app notifications
    match /notifications/{docId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Lessons rules: Dynamic course content can be fetched or modified by signed-in students
    match /lessons/{lessonId} {
      allow read, write: if isSignedIn();
    }
  }
}